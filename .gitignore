tasks/records/.claims/

# Local environment and secrets
.env
.env.*
!.env.example

# Generated logs and temporary files
*.log
*.trace
*.out
tmp/
.tmp/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

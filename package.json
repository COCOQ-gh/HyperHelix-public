{
  "name": "hyperhelix",
  "private": true,
  "type": "module",
  "description": "HyperHelix framework tooling. Runtime dependencies are ratified by HH-067 (yaml + Ajv only).",
  "scripts": {
    "test": "node --test --test-concurrency=16",
    "test:e2e": "node --test test-e2e/pr-flow.e2e.mjs test-e2e/finish-receipt.e2e.mjs test-e2e/consolidation-report.e2e.mjs test-e2e/cost-report.e2e.mjs",
    "test:all": "npm test && npm run test:e2e",
    "validate": "node tools/hyperhelix.mjs validate",
    "verify": "node tools/hyperhelix.mjs verify --staged"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "yaml": "2.9.0"
  }
}
